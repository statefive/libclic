# Any options - options can be short (with no long option), long (with no short
# option) or long and short together

global.options.opts-type = ANY

option.short-only.opts = s
option.short-only.description = This is a short option.
option.short-only.hasArg = true

option.long-only.opts = long
option.long-only.description = This is a long option.
option.long-only.hasArg = true

option.both.opts = a / long-and-short
option.both.description= This is a long and short option.
option.both.hasArg = true